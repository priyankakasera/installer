{
  "categories": [
    {
      "id": "runtimes",
      "name": "Core Programming Runtimes",
      "description": "Foundational tools required to run and develop applications",
      "icon": "🚀",
      "tools": [
        {
          "id": "java",
          "name": "Java (JDK)",
          "description": "Java Development Kit — Required for Java development",
          "versions": ["21.0.10", "17.0.18", "11.0.30"],
          "defaultVersion": "21.0.10",
          "downloadUrls": {
            "21.0.10": "https://download.oracle.com/java/21/latest/jdk-21_windows-x64_bin.msi",
            "17.0.18": "https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.18%2B8/OpenJDK17U-jdk_x64_windows_hotspot_17.0.18_8.msi",
            "11.0.30": "https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.30%2B7/OpenJDK11U-jdk_x64_windows_hotspot_11.0.30_7.msi"
          },
          "installCommand": {
            "msi": "msiexec /i \"{installerPath}\" INSTALLDIR=\"{installDir}\" /quiet /norestart /log \"{logPath}\"",
            "exe": "\"{installerPath}\" /s INSTALLDIR=\"{installDir}\""
          },
          "uninstallSearch": ["Java", "Temurin", "OpenJDK"],
          "defaultInstallDir": "C:\\Program Files\\Java\\jdk-{version}",
          "envVars": {
            "JAVA_HOME": "{installDir}"
          },
          "pathEntries": ["{installDir}\\bin"],
          "verifyCommand": "java -version",
          "verifyRegex": "version \"[\\d.]+",
          "icon": "☕",
          "iconUrl": "icons/java.svg"
        },
        {
          "id": "nodejs",
          "name": "Node.js",
          "description": "JavaScript runtime — Required for frontend and JS development",
          "versions": ["25.8.2", "24.14.1", "22.22.2", "20.20.2", "18.20.8"],
          "defaultVersion": "25.8.2",
          "downloadUrls": {
            "25.8.2": "https://nodejs.org/dist/v25.8.2/node-v25.8.2-x64.msi",
            "24.14.1": "https://nodejs.org/dist/v24.14.1/node-v24.14.1-x64.msi",
            "22.22.2": "https://nodejs.org/dist/v22.22.2/node-v22.22.2-x64.msi",
            "20.20.2": "https://nodejs.org/dist/v20.20.2/node-v20.20.2-x64.msi",
            "18.20.8": "https://nodejs.org/dist/v18.20.8/node-v18.20.8-x64.msi"
          },
          "uninstallSearch": "Node.js",
          "installCommand": {
            "msi": "msiexec /i \"{installerPath}\" /quiet /norestart /log \"{logPath}\""
          },
          "defaultInstallDir": "C:\\Program Files\\nodejs",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\nodejs"],
          "verifyCommand": "node -v",
          "verifyRegex": "v[\\d.]+",
          "icon": "🟢",
          "iconUrl": "icons/nodejs.svg"
        },
        {
          "id": "python",
          "name": "Python",
          "description": "Python runtime — Required for scripting and data development",
          "versions": ["3.14.3", "3.13.12", "3.12.13", "3.11.15", "3.10.20"],
          "defaultVersion": "3.14.3",
          "downloadUrls": {
            "3.14.3": "https://www.python.org/ftp/python/3.14.3/python-3.14.3-amd64.exe",
            "3.13.12": "https://www.python.org/ftp/python/3.13.12/python-3.13.12-amd64.exe",
            "3.12.13": "https://www.python.org/ftp/python/3.12.13/python-3.12.13-amd64.exe",
            "3.11.15": "https://www.python.org/ftp/python/3.11.15/python-3.11.15-amd64.exe",
            "3.10.20": "https://www.python.org/ftp/python/3.10.20/python-3.10.20-amd64.exe"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" /quiet InstallAllUsers=1 PrependPath=1 TargetDir=\"{installDir}\""
          },
          "uninstallSearch": ["Python"],
          "defaultInstallDir": "C:\\Program Files\\Python{version}",
          "envVars": {},
          "pathEntries": ["{installDir}", "{installDir}\\Scripts"],
          "verifyCommand": "python --version",
          "verifyRegex": "Python [\\d.]+",
          "icon": "🐍",
          "iconUrl": "icons/python.svg"
        }
      ]
    },
    {
      "id": "package-managers",
      "name": "Package Managers",
      "description": "Build and dependency management tools for your projects",
      "icon": "📦",
      "tools": [
        {
          "id": "maven",
          "name": "Apache Maven",
          "description": "Build automation tool for Java projects",
          "versions": ["3.9.14"],
          "defaultVersion": "3.9.14",
          "downloadUrls": {
            "3.9.14": "https://dlcdn.apache.org/maven/maven-3/3.9.14/binaries/apache-maven-3.9.14-bin.zip"
          },
          "installCommand": {
            "zip": "extract"
          },
          "defaultInstallDir": "C:\\Program Files\\Maven\\apache-maven-{version}",
          "envVars": {
            "MAVEN_HOME": "{installDir}",
            "M2_HOME": "{installDir}"
          },
          "pathEntries": ["{installDir}\\bin"],
          "verifyCommand": "mvn -version",
          "verifyRegex": "Apache Maven [\\d.]+",
          "icon": "🪶",
          "iconUrl": "icons/maven.svg",
          "dependsOn": ["java"]
        },
        {
          "id": "yarn",
          "name": "Yarn",
          "description": "Fast, reliable, and secure dependency management for Node.js",
          "versions": ["1.22.22"],
          "defaultVersion": "1.22.22",
          "downloadUrls": {
            "1.22.22": "https://github.com/yarnpkg/yarn/releases/download/v1.22.22/yarn-1.22.22.msi"
          },
          "installCommand": {
            "msi": "msiexec /i \"{installerPath}\" /quiet /norestart /log \"{logPath}\""
          },
          "uninstallSearch": ["Yarn"],
          "defaultInstallDir": "C:\\Program Files (x86)\\Yarn",
          "envVars": {},
          "pathEntries": ["C:\\Program Files (x86)\\Yarn\\bin"],
          "verifyCommand": "if exist \"C:\\Program Files (x86)\\Yarn\\bin\\yarn.cmd\" (\"C:\\Program Files (x86)\\Yarn\\bin\\yarn.cmd\" --version) else if exist \"C:\\Program Files\\Yarn\\bin\\yarn.cmd\" (\"C:\\Program Files\\Yarn\\bin\\yarn.cmd\" --version)",
          "verifyRegex": "[\\d]+\\.[\\d]+\\.[\\d]+",
          "icon": "🧶",
          "iconUrl": "icons/yarn.svg",
          "dependsOn": ["nodejs"]
        },
        {
          "id": "gradle",
          "name": "Gradle",
          "description": "Powerful build automation tool for multi-language software development",
          "versions": ["9.4.1"],
          "defaultVersion": "9.4.1",
          "downloadUrls": {
            "9.4.1": "https://services.gradle.org/distributions/gradle-9.4.1-bin.zip"
          },
          "installCommand": {
            "zip": "extract"
          },
          "defaultInstallDir": "C:\\Program Files\\Gradle\\gradle-{version}",
          "envVars": {
            "GRADLE_HOME": "{installDir}"
          },
          "pathEntries": ["{installDir}\\bin"],
          "verifyCommand": "powershell -NoProfile -NonInteractive -Command \"& {if ($env:GRADLE_HOME) { Write-Output ('Gradle ' + (Split-Path -Leaf $env:GRADLE_HOME).Replace('gradle-','')) }}\"",
          "verifyRegex": "Gradle [\\d.]+",
          "icon": "🐘",
          "iconUrl": "icons/gradle.svg",
          "dependsOn": ["java"]
        },
        {
          "id": "chocolatey",
          "name": "Chocolatey",
          "description": "The package manager for Windows — automates software management",
          "versions": ["2.7.0"],
          "defaultVersion": "2.7.0",
          "downloadUrls": {
            "2.7.0": "https://github.com/chocolatey/choco/releases/download/2.7.0/chocolatey-2.7.0.0.msi"
          },
          "installCommand": {
            "msi": "msiexec /i \"{installerPath}\" /quiet /norestart /log \"{logPath}\""
          },
          "uninstallSearch": ["Chocolatey"],
          "defaultInstallDir": "C:\\ProgramData\\chocolatey",
          "envVars": {},
          "pathEntries": ["C:\\ProgramData\\chocolatey\\bin"],
          "verifyCommand": "if exist \"C:\\ProgramData\\chocolatey\\bin\\choco.exe\" (\"C:\\ProgramData\\chocolatey\\bin\\choco.exe\" --version)",
          "verifyRegex": "[\\d]+\\.[\\d]+\\.[\\d]+",
          "icon": "🍫",
          "iconUrl": "icons/chocolatey.png"
        }
      ]
    },
    {
      "id": "vcs",
      "name": "Version Control",
      "description": "Tools used for source code management — essential for all developers",
      "icon": "🔧",
      "tools": [
        {
          "id": "git",
          "name": "Git",
          "description": "Distributed version control system",
          "versions": ["2.53.0"],
          "defaultVersion": "2.53.0",
          "downloadUrls": {
            "2.53.0": "https://github.com/git-for-windows/git/releases/download/v2.53.0.windows.1/Git-2.53.0-64-bit.exe"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" /VERYSILENT /NORESTART /NOCANCEL /SP- /CLOSEAPPLICATIONS /RESTARTAPPLICATIONS /COMPONENTS=\"icons,ext\\reg\\shellhere,assoc,assoc_sh\""
          },
          "uninstallSearch": "Git",
          "defaultInstallDir": "C:\\Program Files\\Git",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\Git\\cmd"],
          "verifyCommand": "git --version",
          "verifyRegex": "git version [\\d.]+",
          "icon": "🔀",
          "iconUrl": "icons/github.svg"
        }
      ]
    },
    {
      "id": "cloud-devops",
      "name": "Cloud & DevOps Tools",
      "description": "Tools for containerization, cloud interaction, and infrastructure management",
      "icon": "☁️",
      "tools": [
        {
          "id": "docker-desktop",
          "name": "Docker Desktop",
          "description": "Bundled container platform — includes Docker Engine, CLI, and Compose",
          "versions": ["4.66.0", "4.51.0"],
          "defaultVersion": "4.66.0",
          "downloadUrls": {
            "4.66.0": "https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe",
            "4.51.0": "https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" install --quiet --accept-license"
          },
          "uninstallSearch": ["Docker Desktop"],
          "silentUninstallArgs": "--quiet",
          "defaultInstallDir": "C:\\Program Files\\Docker\\Docker",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\Docker\\Docker\\resources\\bin"],
          "verifyCommand": "docker --version",
          "verifyRegex": "Docker version [\\d.]+",
          "icon": "🐳",
          "iconUrl": "icons/docker.svg"
        },
        {
          "id": "kubectl",
          "name": "Kubernetes CLI (kubectl)",
          "description": "Command-line tool for controlling Kubernetes clusters",
          "versions": ["1.35.3", "1.34.6", "1.33.10"],
          "defaultVersion": "1.35.3",
          "downloadUrls": {
            "1.35.3": "https://dl.k8s.io/release/v1.35.3/bin/windows/amd64/kubectl.exe",
            "1.34.6": "https://dl.k8s.io/release/v1.34.6/bin/windows/amd64/kubectl.exe",
            "1.33.10": "https://dl.k8s.io/release/v1.33.10/bin/windows/amd64/kubectl.exe"
          },
          "installCommand": {
            "exe": "copy"
          },
          "uninstallSearch": [],
          "defaultInstallDir": "C:\\Program Files\\kubectl",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\kubectl"],
          "verifyCommand": "kubectl version --client",
          "verifyRegex": "Client Version: v[\\d.]+",
          "icon": "☸️",
          "iconUrl": "icons/kubernetes.png"
        },
        {
          "id": "awscli",
          "name": "AWS CLI",
          "description": "Command-line interface for Amazon Web Services",
          "versions": ["2:latest"],
          "defaultVersion": "2:latest",
          "downloadUrls": {
            "2:latest": "https://awscli.amazonaws.com/AWSCLIV2.msi"
          },
          "installCommand": {
            "msi": "msiexec /i \"{installerPath}\" /quiet /norestart /log \"{logPath}\""
          },
          "uninstallSearch": ["AWS Command Line Interface"],
          "defaultInstallDir": "C:\\Program Files\\Amazon\\AWSCLIV2",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\Amazon\\AWSCLIV2"],
          "verifyCommand": "aws --version",
          "verifyRegex": "aws-cli/[\\d.]+",
          "icon": "🔶",
          "iconUrl": "icons/aws.jpeg"
        },
        {
          "id": "azurecli",
          "name": "Azure CLI",
          "description": "Command-line interface for Microsoft Azure",
          "versions": ["2:latest"],
          "defaultVersion": "2:latest",
          "downloadUrls": {
            "2:latest": "https://aka.ms/installazurecliwindowsx64"
          },
          "installCommand": {
            "msi": "msiexec /i \"{installerPath}\" /quiet /norestart /log \"{logPath}\""
          },
          "uninstallSearch": ["Microsoft Azure CLI"],
          "defaultInstallDir": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin"],
          "verifyCommand": "az --version",
          "verifyRegex": "azure-cli\\s+[\\d.]+",
          "icon": "🔷",
          "iconUrl": "icons/azure.png"
        }
      ]
    },
    {
      "id": "ides-editors",
      "name": "IDEs & Code Editors",
      "description": "Integrated development environments and code editors for productive development",
      "icon": "🧑‍💻",
      "tools": [
        {
          "id": "vscode",
          "name": "Visual Studio Code",
          "description": "Lightweight but powerful source code editor by Microsoft",
          "versions": ["latest"],
          "defaultVersion": "latest",
          "downloadUrls": {
            "latest": "https://update.code.visualstudio.com/latest/win32-x64/stable"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" /VERYSILENT /NORESTART /MERGETASKS=!runcode,addcontextmenufiles,addcontextmenufolders,addtopath"
          },
          "uninstallSearch": ["Microsoft Visual Studio Code"],
          "defaultInstallDir": "C:\\Program Files\\Microsoft VS Code",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\Microsoft VS Code\\bin"],
          "verifyCommand": "code --version",
          "verifyRegex": "\\d+\\.\\d+",
          "icon": "💻",
          "iconUrl": "icons/vscode.png"
        },
        {
          "id": "intellij-idea",
          "name": "IntelliJ IDEA",
          "description": "Professional IDE for Java and Kotlin development by JetBrains",
          "versions": ["latest"],
          "defaultVersion": "latest",
          "downloadUrls": {
            "latest": "https://data.services.jetbrains.com/products/download?code=IIC&platform=windows"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" /S /D={installDir}"
          },
          "uninstallSearch": ["IntelliJ IDEA"],
          "startMenuFolders": ["JetBrains"],
          "startMenuKeywords": ["IntelliJ IDEA"],
          "defaultInstallDir": "C:\\Program Files\\JetBrains\\IntelliJ IDEA Community",
          "envVars": {},
          "pathEntries": ["{installDir}\\bin"],
          "verifyCommand": "powershell -NoProfile -NonInteractive -Command \"$found=$false;$dirs=@('C:\\Program Files\\JetBrains','C:\\Program Files (x86)\\JetBrains',(Join-Path $env:LOCALAPPDATA 'JetBrains\\Toolbox\\apps'),(Join-Path $env:LOCALAPPDATA 'Programs'));foreach($d in $dirs){if(-not $found -and (Test-Path $d)){$f=Get-ChildItem $d -Filter idea64.exe -Recurse -Depth 4 -EA 0|Select -First 1;if($f){Write-Output ('IntelliJ IDEA '+$f.VersionInfo.ProductVersion);$found=$true}}};if(-not $found){$w=Get-Command idea64.exe -EA 0;if($w){Write-Output 'IntelliJ IDEA found'}}\"",
          "verifyRegex": "IntelliJ IDEA",
          "icon": "🧠",
          "iconUrl": "icons/intellij.png"
        },
        {
          "id": "notepadpp",
          "name": "Notepad++",
          "description": "Free source code editor and Notepad replacement for Windows",
          "versions": ["8.9.3"],
          "defaultVersion": "8.9.3",
          "downloadUrls": {
            "8.9.3": "https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v8.9.3/npp.8.9.3.Installer.x64.exe"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" /S"
          },
          "uninstallSearch": ["Notepad++"],
          "defaultInstallDir": "C:\\Program Files\\Notepad++",
          "envVars": {},
          "pathEntries": ["C:\\Program Files\\Notepad++"],
          "verifyCommand": "where notepad++",
          "verifyRegex": "notepad",
          "icon": "📝",
          "iconUrl": "icons/notepadpp.png"
        }
      ]
    },
    {
      "id": "api-testing",
      "name": "API & Testing Tools",
      "description": "Tools for API development, testing, and debugging",
      "icon": "🧪",
      "tools": [
        {
          "id": "postman",
          "name": "Postman",
          "description": "API platform for building, testing, and documenting APIs",
          "versions": ["12"],
          "defaultVersion": "12",
          "downloadUrls": {
            "12": "https://dl.pstmn.io/download/latest/win64"
          },
          "installCommand": {
            "exe": "\"{installerPath}\" --silent"
          },
          "uninstallSearch": ["Postman"],
          "defaultInstallDir": "%LOCALAPPDATA%\\Postman",
          "envVars": {},
          "pathEntries": [],
          "verifyCommand": "powershell -NoProfile -NonInteractive -Command \"& { $paths = @(\\\"$env:LOCALAPPDATA\\Postman\\Postman.exe\\\", \\\"$env:LOCALAPPDATA\\Programs\\Postman\\Postman.exe\\\", 'C:\\Program Files\\Postman\\Postman.exe'); foreach ($p in $paths) { if (Test-Path $p) { Write-Output 'Postman installed'; return } } }\"",
          "verifyRegex": "Postman installed",
          "icon": "🟧",
          "iconUrl": "icons/postman.svg"
        }
      ]
    }
